<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable] w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix="">
      <%= assigns[:page_title] || "Chattr Live" %>
    </.live_title>
     <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <!--Joe-->
    <link rel="stylesheet" href="https://use.typekit.net/vzz8fcr.css" />
    <!--Maddy-->
    <link rel="stylesheet" href="https://use.typekit.net/uxu5yyi.css" />
    <!--Google-->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>

  <body class="bg-white">
    <div class="flex justify-between px-4 py-4">
      <div>
        <div>
          <.link href={~p"/"}>
            <.icon name="hero-home" class="w-8 h-8" />
          </.link>
        </div>
      </div>

      <ul class="flex items-center justify-end gap-4 sm:px-6 lg:px-8">
        <%= if @current_user do %>
          <li class="text-[0.7rem] sm:text-[0.8125rem] lg:text-lg leading-6 text-zinc-900 font-semibold hover:text-zinc-700">
            <.link href={~p"/course_pages/"}>Feedback Pages</.link>
          </li>
          <!-- Remove
          <li class="text-[0.7rem] sm:text-[0.8125rem] leading-6 text-zinc-900">
            <%= @current_user.email %>
          </li>-->
          <li>
            <.link href={~p"/users/settings"}>
              <.icon name="hero-user-circle" class="w-8 h-8" />
            </.link>
          </li>
          <!--
          <li>
            <.link
              href={~p"/users/settings"}
              class="text-[0.7rem] sm:text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
            >
              Settings
            </.link>
          </li>

          <li>
            <.link
              href={~p"/users/log_out"}
              method="delete"
              class="text-[0.7rem] sm:text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
            >
              Log out
            </.link>
          </li> -->
        <% else %>
          <li>
            <.link
              href={~p"/users/register"}
              class="text-[0.7rem] sm:text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
            >
              Register
            </.link>
          </li>

          <li>
            <.link
              href={~p"/users/log_in"}
              class="text-[0.7rem] sm:text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
            >
              Log in
            </.link>
          </li>
        <% end %>
      </ul>
    </div>
     <hr /> <%= @inner_content %>
  </body>
</html>
