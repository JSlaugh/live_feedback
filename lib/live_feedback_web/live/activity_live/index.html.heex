<.activity_template>
  <:leftSidebar>
    <div>Left Sidebar</div>
  </:leftSidebar>
  <:activity>
    <div>
      <h1>Example Question Section</h1>
      <p>This might be the area where the box with the question might go.</p>
    </div>
    <div>
      <h1>Activity Section</h1>
      <h1>Example Activity</h1>
      <%= if @current_question.question_type == "QA" do %>
        <.live_component
        module={LiveFeedbackWeb.QaComponent}
        id="example-activity"
        page_admin={@page_admin}
        course_page={@course_page}
        current_question={@current_question}
        sort_by={@sort_by}
        streams={@streams}
        anonymous_id={@anonymous_id}
        live_action={@live_action}
        message={@message}
        page_title={@page_title}
        queue_id={@queue_id}
        parent_pid={self()}
        />
      <% else %>
        <.live_component
        module={LiveFeedbackWeb.QuizComponent}
        id="example-activity2"
        profile_id={@profile_id}
        current_question={@current_question}
        responses={@responses}
        parent_pid={self()}
        />
      <% end %>
    </div>
     <div class="flex justify-between items-center mt-8 mb-4">
      <button class="p-2 rounded-full bg-gray-100 hover:bg-gray-200" phx-click="change_question" phx-value-direction="previous">
        <.icon name="hero-chevron-left" />
        <span class="sr-only">Previous Question</span>
      </button>
      <button class="p-2 rounded-full bg-gray-100 hover:bg-gray-200" phx-click="change_question" phx-value-direction="next">
        <.icon name="hero-chevron-right" />
        <span class="sr-only">Next Question</span>
      </button>
    </div>
  </:activity>
  <:rightSidebar>
    <div>Right Sidebar</div>
  </:rightSidebar>
</.activity_template>
