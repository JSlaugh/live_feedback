<.header>
  <div class="w-full border-b border-gray-200">
    <div class="w-full">
      <!-- Top section with title and navigation -->
      <div class="flex flex-col max-sm:items-center max-sm:justify-between sm:justify-start mb-4 mx-4 mt-4">
        <div>
          <h1 class="max-sm:text-2xl sm:text-4xl font-bold lg:text-6xl sm:pb-4">
            <%= if @present_mode == "owner" do %>
              My Feedback Pages
            <% else %>
              Saved Pages
            <% end %>
          </h1>
          <!-- Action button section -->
        </div>

        <div class="flex max-sm:flex max-sm:flex-col justify-between space-x-4 mr-4 max-sm:mt-4">
          <div>
            <.link
              navigate={~p"/course_pages"}
              class={
                if @present_mode == "user" do
                  "px-4 py-2 font-medium border-b-2 border-logo_red text-logo_red"
                else
                  "px-4 py-2 font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-600"
                end
              }
            >
              Join
            </.link>

            <.link
              navigate={~p"/course_pages/host"}
              class={
                if @present_mode == "owner" do
                  "px-4 py-2 font-medium border-b-2 border-logo_red text-logo_red"
                else
                  "px-4 py-2 font-medium border-b-2 border-transparent text-gray-400 hover:text-gray-600"
                end
              }
            >
              Host
            </.link>
          </div>

          <div class="flex items-center justify-center max-sm:mt-6 max-sm:mb-2">
            <%= if @present_mode == "owner" do %>
              <.link
                patch={~p"/course_pages/new"}
                class="bg-logo_red hover:bg-brand_dark_red text-white p-1 sm:p-2 rounded-lg"
              >
                <button class="mx-2">Create <.icon name="hero-plus" class="h-5 w-5" /></button>
              </.link>
            <% else %>
              <.link
                patch={~p"/course_pages/join"}
                class="bg-logo_red hover:bg-brand_dark_red text-white p-1 sm:p-2 rounded-lg"
              >
                <button class="mx-2">Join <.icon name="hero-plus" class="h-5 w-5" /></button>
              </.link>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</.header>

<%= if @present_mode == "owner" do %>
  <.table
    id="course_pages"
    rows={@streams.course_pages}
    row_click={
      fn {_id, course_page} ->
        if @present_mode == "owner" do
          JS.navigate(~p"/course_pages/#{course_page.id}/queues")
        else
          JS.navigate(~p"/page/#{course_page.slug}")
        end
      end
    }
  >
    <:col :let={{_id, course_page}} label="Title"><%= course_page.title %></:col>

    <:col :let={{_id, course_page}} label="Description"><%= course_page.description %></:col>

    <:col :let={{_id, course_page}} label="Slug" class="hidden sm:table-cell">
      <%= course_page.slug %>
    </:col>

    <:col :let={{_id, course_page}} label="Participation Data" class="hidden sm:table-cell">
      <.link patch={~p"/course_pages/#{course_page}/participation"}>
        <span>View</span> <.icon name="hero-document-text" class="text-blue-500" />
      </.link>
    </:col>

    <:action :let={{_id, course_page}}>
      <.link patch={~p"/course_pages/#{course_page}/edit"}>
        <.icon name="hero-pencil-square" class="text-brand_blue" />
      </.link>
    </:action>

    <:action :let={{id, course_page}}>
      <.link
        phx-click={JS.push("delete", value: %{id: course_page.id}) |> hide("##{id}")}
        data-confirm="Are you sure you want to delete this class?"
      >
        <.icon name="hero-trash" class="text-red-500" />
      </.link>
    </:action>

    <:action :let={{_id, course_page}}>
      <.link patch={~p"/course_pages/#{course_page}/share"}>
        <.icon name="hero-user-plus" class="text-brand_blue" />
      </.link>
    </:action>
  </.table>
<% else %>
  <!--Favorites -->
  <h4 class="mt-4 sm:text-2xl font-bold lg:text-4xl sm:py-4 text-brand_blue">
    Favorites <.icon name="hero-star" class="text-brand_blue max-sm:w-5 " />
  </h4>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 mt-8">
    <%= for {id, course_page} <- @streams.course_pages, course_page.user_profile.is_course_page_favorite do %>
      <div
        id={id}
        phx-click={JS.navigate(~p"/page/#{course_page.slug}")}
        class="relative flex flex-col  bg-brand_navy hover:opacity-95 shadow-sm hover:shadow-lg border border-slate-200 rounded-lg w-full"
      >
        <div class="p-4">
          <h5 class="mb-2 text-white text-xl break-all font-semibold max-w-[80%] md:max-w-[90%]">
            <%= course_page.title %>
          </h5>

          <p class="text-white leading-normal break-all max-w-[80%] md:max-w-[90%]">
            <%= course_page.description %>
          </p>
        </div>

        <div>
          <div class="absolute bottom-0 right-0 p-1 px-2 m-4 bg-white rounded-md text-logo_red font-bold">
            <.link phx-click={JS.push("leave", value: %{id: course_page.id}) |> hide("##{id}")}>
              Leave
            </.link>
          </div>

          <div
            phx-click="toggle-favorite"
            phx-value-id={course_page.id}
            class="absolute top-0 right-0 p-4 cursor-pointer group"
          >
            <span class="block group-hover:hidden">
              <.icon name="hero-star-solid" class="text-brand_blue" />
            </span>

            <span class="hidden group-hover:block">
              <.icon name="hero-star" class="text-brand_blue" />
            </span>
          </div>
        </div>

        <div></div>
      </div>
    <% end %>
  </div>
  <!--All -->
  <h4 class="mt-10 sm:text-2xl font-bold lg:text-4xl sm:py-4 text-brand_blue">All Courses</h4>

  <div class="grid grid-cols-1 gap-8 mt-8">
    <%= for {id, course_page} <- @streams.course_pages, not course_page.user_profile.is_course_page_favorite do %>
      <div
        id={id}
        phx-click={JS.navigate(~p"/page/#{course_page.slug}")}
        class="relative flex flex-col  bg-brand_navy hover:opacity-95 shadow-sm hover:shadow-lg border border-slate-200 rounded-lg w-full"
      >
        <div class="p-4">
          <h5 class="mb-2 text-white text-xl break-all font-semibold max-w-[80%] md:max-w-[90%]">
            <%= course_page.title %>
          </h5>

          <p class="text-white leading-normal break-all max-w-[80%] md:max-w-[90%]">
            <%= course_page.description %>
          </p>
        </div>

        <div>
          <div class="absolute bottom-0 right-0 p-1 px-2 m-4 bg-white rounded-md text-logo_red font-bold">
            <.link phx-click={JS.push("leave", value: %{id: course_page.id}) |> hide("##{id}")}>
              Leave
            </.link>
          </div>

          <div
            phx-click="toggle-favorite"
            phx-value-id={course_page.id}
            class="absolute top-0 right-0 p-4 cursor-pointer group"
          >
            <span class="block group-hover:hidden">
              <.icon name="hero-star" class="text-brand_blue" />
            </span>

            <span class="hidden group-hover:block">
              <.icon name="hero-star-solid" class="text-brand_blue" />
            </span>
          </div>
        </div>

        <div></div>
      </div>
    <% end %>
  </div>
<% end %>

<.modal
  :if={@live_action in [:new, :edit]}
  id="course_page-modal"
  show
  on_cancel={JS.patch(~p"/course_pages/host")}
>
  <.live_component
    module={LiveFeedbackWeb.CoursePageLive.NewCourseFormComponent}
    id={@course_page.id || :new}
    title={@page_title}
    action={@live_action}
    course_page={@course_page}
    current_user={@current_user}
    patch={~p"/course_pages/host"}
  />
</.modal>

<.modal
  :if={@live_action in [:join]}
  id="course_page-join-modal"
  show
  on_cancel={JS.patch(~p"/course_pages")}
>
  <.live_component
    module={LiveFeedbackWeb.CoursePageLive.JoinCourseFormComponent}
    id={:join}
    title={@page_title}
    action={@live_action}
    course_page={@course_page}
    current_user={@current_user}
    patch={~p"/course_pages"}
  />
</.modal>

<.modal
  :if={@live_action in [:share]}
  id="course_page-modal"
  show
  on_cancel={JS.patch(~p"/course_pages/host")}
>
  <.live_component
    module={LiveFeedbackWeb.CoursePageLive.SettingsComponent}
    id={@course_page.id || :share}
    title={@page_title}
    action={@live_action}
    course_page={@course_page}
    current_user={@current_user}
    profiles={@profiles}
    patch={~p"/course_pages/host"}
  />
</.modal>
