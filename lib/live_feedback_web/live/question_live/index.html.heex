<.back_button to={~p"/course_pages/#{@course_page.id}/queues"} text="Back" />
<div class="flex flex-col items-end mb-6">
  <h3 class="text-lg font-semibold mb-2 pb-1 border-b border-gray-300 w-md text-center">
    Presentation
  </h3>
  
  <div class="flex items-center justify-center gap-4">
    <label
      phx-click="toggle_present"
      phx-value-queue_id={@queue.id}
      class="relative inline-flex items-center cursor-pointer"
    >
      <input
        type="checkbox"
        name="is_required"
        checked={@queue.is_presenting}
        class="sr-only peer"
      />
      <div class="w-20 h-8 flex items-center justify-between px-2 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-12 peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-blue-600">
        <%= if @queue.is_presenting do %>
          <span class="text-xs text-white font-bold pl-0.5 z-10">Stop</span>
          <span class="text-xs text-gray-800 font-bold pr-0.5 z-10 opacity-0">Start</span>
        <% else %>
          <span class="text-xs text-white font-bold pl-0.5 z-10 opacity-0">Stop</span>
          <span class="text-xs text-gray-800 font-bold pr-0.5 z-10">Start</span>
        <% end %>
      </div>
    </label>
    
    <button
      phx-click="navigate"
      phx-value-url={~p"/page/#{@course_page.slug}"}
      class="bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded disabled:opacity-50 disabled:cursor-not-allowed h-8 flex items-center"
      disabled={!@queue.is_presenting}
    >
      Go
    </button>
  </div>
</div>

<h1 class="text-xl font-bold mb-4"><%= @course_page.title %> Questions:</h1>

<%= if Enum.count(@streams.questions) == 0 do %>
  <p class="text-gray-500">No questions available.</p>
<% else %>
  <div id="question_box" phx-update="stream">
    <!-- loop through and display each question in stream -->
    <div :for={{id, question} <- @streams.questions} id={id}>
      <.live_component
        module={LiveFeedback.QuestionLive.QuestionComponent}
        question={question}
        question_type={@question_type}
        id={"question_#{question.id}"}
        show_form={@show_form}
        max_question_num={@max_question_num}
        stream={@streams.questions}
      />
    </div>
  </div>
<% end %>
<!-- #form for adding new question at bottom -->
<%= if @show_add_form do %>
  <.live_component
    module={LiveFeedbackWeb.QuestionLive.FormComponent}
    question_type={@question_type}
    phx-key="new_form"
    id="new_form"
    question={
      %{id: "new", question_content: "", is_required: false, question_options_occurrences: []}
    }
  />
<% end %>
<!-- #line and box with + icon for showing new form-->
<div class="flex items-center justify-center my-4 relative w-full">
  <!-- Line -->
  <div class="absolute inset-0 flex items-center">
    <hr class="w-full border-t-2 border-gray-300" />
  </div>
  <!-- Button inside square box -->
  <button
    phx-click="toggle_new_form"
    class="relative z-10 inline-flex items-center justify-center p-0 w-8 h-8 bg-white border-2 border-gray-300 rounded-md"
  >
    <.icon name="hero-plus" class="text-gray-300 h-5 w-5 stroke-3" />
  </button>
</div>
<!-- #modal for confirming deletion -->
<.modal :if={@confirm_delete} id="message-modal" show>
  <div class="bg-white p-6 rounded-lg shadow-lg w-full">
    <h2 class="text-lg font-semibold text-gray-800">Confirm Deletion</h2>
    
    <p class="text-gray-600 mt-2">
      This will delete all responses associated with this question.
    </p>
    
    <p class="text-gray-600 mt-2">To retain question responses archive the question.</p>
    
    <div class="flex justify-end mt-4 space-x-2">
      <button
        phx-click="delete_question"
        phx-value-id={@delete_id}
        class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition"
      >
        Delete <.icon name="hero-trash" class="inline-block w-5 h-5 ml-1" />
      </button>
      
      <button
        phx-click="archive_question"
        phx-value-id={@delete_id}
        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
      >
        Archive <.icon name="hero-archive-box" class="inline-block w-5 h-5 ml-1" />
      </button>
    </div>
  </div>
</.modal>
