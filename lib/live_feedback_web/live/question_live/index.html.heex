<h1 class="text-xl font-bold mb-4"><%= @course_name %> Questions:</h1>

<%= if Enum.count(@streams.questions) == 0 do %>
  <p class="text-gray-500">No questions available.</p>
<% else %>
  <div id="questions" phx-update="append" class="space-y-4">
    <%= for {id, question} <- @streams.questions do %>
      <.live_component
      module={LiveFeedback.QuestionLive.QuestionComponent}
      question={question}
      id={"question_#{id}"}
      question_type={@question_type}
      show_form={@show_form}
    />
      <% end %>
  </div>
<% end %>

<%= if @show_form == "add" do %>
<.live_component module={LiveFeedbackWeb.QuestionLive.FormComponent} question_type={@question_type} id={"new_form"}/>
<% end %>


<div class="flex items-center justify-center my-4 relative w-full">
  <!-- Line -->
  <div class="absolute inset-0 flex items-center">
    <hr class="w-full border-t-2 border-gray-300" />
  </div>

  <!-- Button inside square box -->
  <button phx-click="toggle_form" phx-value-form="add"} class="relative z-10 inline-flex items-center justify-center p-0 w-8 h-8 bg-white border-2 border-gray-300 rounded-md">
    <.icon name="hero-plus" class="text-gray-300 h-5 w-5 stroke-3" />
  </button>
</div>
